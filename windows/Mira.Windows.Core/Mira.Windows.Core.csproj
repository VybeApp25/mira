<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Not net10.0-windows: the bulk of this project (routing/entitlement/session
         logic, business rules) is genuinely portable .NET. But it does contain a
         few Windows-only calls (DPAPI today; WMI next) — declaring the platform
         here (rather than ignoring CA1416) is the correct fix per the analyzer's
         own guidance, and is honest about this being a Windows-only assembly in
         practice, not a claim that every line in it is portable. -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <!-- ScreenCapture.cs reads Bitmap pixel data via a raw pointer for speed
         when building the change-detection fingerprint. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>

  <!--
    Linked (not copied) from shared/codegen/generated/csharp/ — the C# side of
    shared/contracts/, generated by quicktype. See shared/codegen/README.md.
    Linking (rather than copying) means regenerating those files after a contract
    change picks up here automatically with no manual sync step. Only the files
    Phase 2 (auth/entitlements/device-lock) actually needs are linked so far;
    link more as later phases need them (voice, model routing, etc.) — see
    docs/windows/IMPLEMENTATION_PLAN.md.
  -->
  <ItemGroup>
    <Compile Include="..\..\shared\codegen\generated\csharp\SessionResponse.cs" Link="Generated\SessionResponse.cs" />
    <Compile Include="..\..\shared\codegen\generated\csharp\SignInRequest.cs" Link="Generated\SignInRequest.cs" />
    <Compile Include="..\..\shared\codegen\generated\csharp\SignUpRequest.cs" Link="Generated\SignUpRequest.cs" />
    <Compile Include="..\..\shared\codegen\generated\csharp\ProfileRow.cs" Link="Generated\ProfileRow.cs" />
    <Compile Include="..\..\shared\codegen\generated\csharp\ErrorResponse.cs" Link="Generated\ErrorResponse.cs" />
    <Compile Include="..\..\shared\codegen\generated\csharp\CheckDevice.cs" Link="Generated\CheckDevice.cs" />
    <Compile Include="..\..\shared\codegen\generated\csharp\RegisterDevice.cs" Link="Generated\RegisterDevice.cs" />
    <Compile Include="..\..\shared\codegen\generated\csharp\MintRealtimeToken.cs" Link="Generated\MintRealtimeToken.cs" />
    <Compile Include="..\..\shared\codegen\generated\csharp\ReportVoiceUsage.cs" Link="Generated\ReportVoiceUsage.cs" />
  </ItemGroup>

</Project>
