<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Mira.Windows.Core\Mira.Windows.Core.csproj" />
  </ItemGroup>

  <!-- Mira's real UI sound cues, copied from the Mac app's own Resources bundle
       (same files, MP3/WAV are not platform-specific). AudioCueService reads
       these from the running exe's own directory at runtime. -->
  <ItemGroup>
    <None Include="Assets\Sounds\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WPF has no native tray-icon control; System.Windows.Forms.NotifyIcon via
         interop is the standard, dependency-free way to get one (see TrayIconManager). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
