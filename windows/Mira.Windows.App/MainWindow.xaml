<Window x:Class="Mira.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mira.Windows.App"
        mc:Ignorable="d"
        Title="Mira" Height="420" Width="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Mira" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" />

        <!-- Signed-out: sign-in / sign-up form -->
        <StackPanel x:Name="SignedOutPanel" Grid.Row="1">
            <TextBlock x:Name="ModeLabel" Text="Sign in" FontSize="16" Margin="0,0,0,12" />

            <TextBlock Text="Email" Margin="0,0,0,4" />
            <TextBox x:Name="EmailBox" Margin="0,0,0,12" />

            <TextBlock Text="Password" Margin="0,0,0,4" />
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12" />

            <StackPanel x:Name="DisplayNamePanel" Visibility="Collapsed">
                <TextBlock Text="Name" Margin="0,0,0,4" />
                <TextBox x:Name="DisplayNameBox" Margin="0,0,0,12" />
            </StackPanel>

            <Button x:Name="PrimaryActionButton" Content="Sign In" Height="32" Click="PrimaryActionButton_Click" />

            <Button x:Name="ToggleModeButton" Content="Need an account? Create one" Margin="0,10,0,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"
                    Click="ToggleModeButton_Click" />

            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>

        <!-- Signed-in: status -->
        <StackPanel x:Name="SignedInPanel" Grid.Row="1" Visibility="Collapsed">
            <TextBlock x:Name="SignedInAsText" FontSize="14" Margin="0,0,0,8" />
            <TextBlock x:Name="PlanText" FontSize="14" Margin="0,0,0,20" />
            <Button Content="Open Chat" Height="32" Click="OpenChatButton_Click" Margin="0,0,0,8" FontWeight="Bold" />
            <Button Content="Open Voice" Height="32" Click="OpenVoiceButton_Click" Margin="0,0,0,8" />
            <Button Content="Refresh plan" Height="30" Click="RefreshPlanButton_Click" Margin="0,0,0,16" />

            <Border BorderBrush="#E0A000" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="AutonomyCheckBox" Content="Allow Mira to control my screen (computer use)"
                              Checked="AutonomyCheckBox_Changed" Unchecked="AutonomyCheckBox_Changed" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#886600" Margin="0,4,0,0"
                               Text="When on, chat requests can move your mouse, click, type, and take screenshots to complete tasks. Off by default — Windows has no per-use consent prompt for this the way some other permissions do, so this checkbox is the only gate." />
                </StackPanel>
            </Border>

            <Button Content="Sign Out" Height="30" Click="SignOutButton_Click" />
        </StackPanel>
    </Grid>
</Window>
