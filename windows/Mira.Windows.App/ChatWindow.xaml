<Window x:Class="Mira.Windows.App.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mira.Windows.App"
        mc:Ignorable="d"
        Title="Mira Chat" Height="600" Width="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter" />
        <local:BoolToBubbleBrushConverter x:Key="BoolToBubbleBrushConverter" />
        <local:BoolToBubbleForegroundConverter x:Key="BoolToBubbleForegroundConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <ItemsControl x:Name="MessagesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ChatBubbleViewModel}">
                        <Border Margin="4"
                                Padding="10,6"
                                CornerRadius="10"
                                MaxWidth="360"
                                HorizontalAlignment="{Binding IsUser, Converter={StaticResource BoolToAlignmentConverter}}"
                                Background="{Binding IsUser, Converter={StaticResource BoolToBubbleBrushConverter}}">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                       Foreground="{Binding IsUser, Converter={StaticResource BoolToBubbleForegroundConverter}}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" Height="32" VerticalContentAlignment="Center"
                     KeyDown="InputBox_KeyDown" />
            <Button x:Name="SendButton" Grid.Column="1" Content="Send" Width="70" Height="32" Margin="8,0,0,0"
                    Click="SendButton_Click" />
        </Grid>
    </Grid>
</Window>
