{
  "name": "@composio/anthropic",
  "version": "0.9.2",
  "description": "Non-Agentic Provider for Anthropic in Composio SDK",
  "main": "dist/index.mjs",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "keywords": [
    "composio",
    "provider",
    "anthropic"
  ],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@composio/core": ">=0.10.0 <1.0.0",
    "@mastra/mcp": "^0.12.0"
  },
  "devDependencies": {
    "tsdown": "^0.18.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@composio/core": "0.10.0"
  },
  "scripts": {
    "clean": "git clean -xdf node_modules",
    "build": "pnpm exec tsdown",
    "test": "vitest run"
  },
  "types": "dist/index.d.mts"
}